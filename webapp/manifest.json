{
  "_version": "1.73.1",
  "sap.app": {
    "id": "verifications.verificationui5",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.1",
      "toolsId": "47bdb11f-183f-4322-9411-99d21c739b91"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/SerialService/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/mainService/metadata.xml",
          "annotations": [
            "annotation"
          ]
        }
      },
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotations.xml",
        "settings": {
          "localUri": "annotations/annotations.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "verification_Semantic_Object-display": {
          "semanticObject": "verification_Semantic_Object",
          "action": "display",
          "title": "{{verification_Semantic_Object-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "verifications.verificationui5.i18n.i18n"
        }
      },
      "": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "synchronizationMode": "None"
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SerialDataList",
          "target": "SerialDataList"
        },
        {
          "pattern": "SerialData({key}):?query:",
          "name": "SerialDataObjectPage",
          "target": "SerialDataObjectPage"
        }
      ],
      "targets": {
        "SerialDataList": {
          "type": "Component",
          "id": "SerialDataList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/SerialData",
              "variantManagement": "Page",
              "navigation": {
                "SerialData": {
                  "detail": {
                    "route": "SerialDataObjectPage"
                  }
                }
              }
            }
          }
        },
        "SerialDataObjectPage": {
          "type": "Component",
          "id": "SerialDataObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/SerialData",
              "editableHeaderContent": false,
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.FieldGroup#i18nserialeditsection": {
                  "fields": {
                    "Serial_Edit_Section": {
                      "template": "verifications.verificationui5.ext.fragment.Serial_Edit_Section",
                      "label": "機番編集ラベル"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "verificationsverificationui5"
  }
}
